{
  "name": "letting-agency-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test tests/index.test.ts",
    "test:unit": "node --import tsx --test tests/core-rules.unit.test.ts tests/landlord-passive-policy.test.ts",
    "test:integration:pg": "node --import tsx --test tests/postgres-landlord-constraints.integration.test.ts tests/otp-flow.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.0",
    "prisma": "^5.22.0",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": "20.x"
  }
}
