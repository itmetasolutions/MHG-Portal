NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
APP_URL=http://localhost:3000
AUTH_SESSION_SECRET=
# Optional alias if you prefer SESSION_SECRET naming
SESSION_SECRET=
# Optional alias if you prefer JWT_SECRET naming
JWT_SECRET=
AUTH_COOKIE_NAME=session_token
AUTH_SESSION_TTL_HOURS=12

# Supported: console | resend | smtp
EMAIL_PROVIDER=resend
OTP_EMAIL_FROM=
OTP_TTL_MINUTES=10
OTP_MAX_SENDS_PER_WINDOW=5
OTP_SEND_WINDOW_MINUTES=10
OTP_MAX_VERIFY_ATTEMPTS_PER_CODE=5
OTP_MAX_VERIFY_ATTEMPTS_PER_WINDOW=10
OTP_VERIFY_WINDOW_MINUTES=10
ALLOW_ADMIN_PASSIVE_REVERT=false

# Required only when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Required only when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Seed-only admin bootstrap values
ADMIN_EMAIL=
ADMIN_PASSWORD=
